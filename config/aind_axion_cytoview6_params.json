{
  "pipeline_version": "1.3.0",
  "job_dispatch": {
    "split_segments": true,
    "split_groups": true,
    "debug": false,
    "debug_duration": 30,
    "skip_timestamps_check": false,
    "multi_session": false,
    "input": "nwb"
  },
  "preprocessing": {
    "job_kwargs": {
      "chunk_duration": "1s",
      "progress_bar": false,
      "mp_context": "spawn"
    },
    "filter_type": "highpass",
    "remove_out_channels": false,
    "remove_bad_channels": false,
    "min_preprocessing_duration": 30,
    "max_bad_channel_fraction": 0.75,
    "denoising_strategy": "cmr",
    "custom_preprocessing_pipeline": {
      "astype": {
        "dtype": "int16"
      }
    },
    "default_preprocessing_pipeline": {
      "phase_shift": {
        "margin_ms": 100.0
      },
      "highpass_filter": {
        "freq_min": 300.0
      },
      "common_reference": {
        "reference": "global",
        "operator": "median"
      }
    },
    "motion_correction": {
      "compute": false,
      "apply": false,
      "preset": "dredge_fast",
      "detect_kwargs": {},
      "select_kwargs": {},
      "localize_peaks_kwargs": {},
      "estimate_motion_kwargs": {
        "win_step_norm": 0.1,
        "win_scale_norm": 0.1
      },
      "interpolate_motion_kwargs": {}
    }
  },
  "spikesorting": {
    "sorter": "kilosort4",
    "kilosort4": {
      "job_kwargs": {
        "chunk_duration": "1s",
        "progress_bar": false
      },
      "skip_motion_correction": true,
      "min_drift_channels": 65,
      "raise_if_fails": true,
      "clear_cache": false,
      "sorter": {
        "batch_size": 15000,
        "nblocks": 0,
        "Th_universal": 9,
        "Th_learned": 8,
        "do_CAR": false,
        "invert_sign": false,
        "nt": 31,
        "shift": null,
        "scale": null,
        "artifact_threshold": null,
        "nskip": 25,
        "whitening_range": 16,
        "highpass_cutoff": 300,
        "binning_depth": 5,
        "sig_interp": 20,
        "drift_smoothing": [
          0.5,
          0.5,
          0.5
        ],
        "nt0min": null,
        "dmin": 300,
        "dminx": 300,
        "min_template_size": 50,
        "template_sizes": 5,
        "nearest_chans": 5,
        "nearest_templates": 64,
        "max_channel_distance": 350,
        "templates_from_data": true,
        "n_templates": 6,
        "n_pcs": 6,
        "Th_single_ch": 6,
        "acg_threshold": 0.2,
        "ccg_threshold": 0.25,
        "cluster_downsampling": 20,
        "x_centers": 8,
        "duplicate_spike_ms": 0.25,
        "save_preprocessed_copy": false,
        "torch_device": "auto",
        "bad_channels": null,
        "clear_cache": false,
        "save_extra_vars": false,
        "do_correction": false,
        "keep_good_only": false,
        "skip_kilosort_preprocessing": true,
        "use_binary_file": null,
        "delete_recording_dat": true
      }
    }
  },
  "postprocessing": {
    "job_kwargs": {
      "chunk_duration": "1s",
      "progress_bar": false
    },
    "use_motion_corrected": false,
    "sparsity": {
      "method": "radius",
      "radius_um": 350
    },
    "duplicate_threshold": 0.9,
    "return_in_uV": true,
    "extensions": {
      "random_spikes": {
        "max_spikes_per_unit": 500,
        "method": "uniform",
        "margin_size": null,
        "seed": null
      },
      "templates": {},
      "spike_amplitudes": {
        "peak_sign": "neg"
      },
      "template_similarity": {
        "method": "l1"
      },
      "correlograms": {
        "window_ms": 50.0,
        "bin_ms": 1.0
      },
      "unit_locations": {
        "method": "monopolar_triangulation"
      }
    }
  },
  "nwb": {
    "ecephys": {
      "backend": "zarr",
      "stub": false,
      "stub_seconds": 10,
      "write_lfp": false,
      "write_raw": false
    }
  }
}
