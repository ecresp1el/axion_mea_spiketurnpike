#!/usr/bin/env bash
# Copy this file under PROJECT_ROOT/jobs or config/ and edit for a real well.

source "${PROJECT_CONFIG:-/home/elcrespo/Desktop/githubprojects/axion_mea_spiketurnpike/config/greatlakes_project.env}"

export PLATE_TYPE="${PLATE_TYPE:-48_opto}"
export PLATE_MAP="${PLATE_MAP:-${PLATE_MAP_48_OPTO}}"
export ELECTRODE_GEOMETRY="${ELECTRODE_GEOMETRY:-${ELECTRODE_GEOMETRY_4X4}}"

export RECORDING_STEM="${RECORDING_STEM:-replace_with_axion_recording_stem}"
export WELL="${WELL:-A1}"

# Kilosort needs a continuous row-major binary trace. This should be one well
# extracted/converted from the Axion recording, not the spike-list CSV.
export BINARY_FILE="${BINARY_FILE:-${KILOSORT_BINARY_ROOT}/${RECORDING_STEM}/${WELL}.bin}"
export OUTPUT_DIR="${OUTPUT_DIR:-${KILOSORT_RESULTS_ROOT}/${RECORDING_STEM}/${WELL}}"

export FS="${FS:-12500}"
export DTYPE="${DTYPE:-int16}"
export N_CHAN_BIN="${N_CHAN_BIN:-16}"
export DO_CAR="${DO_CAR:-true}"
export INVERT_SIGN="${INVERT_SIGN:-false}"
export RUN_KILOSORT="${RUN_KILOSORT:-false}"

# Lumos MEA 48 one-well Kilosort4 defaults. Override these for CytoView MEA 6.
export NBLOCKS="${NBLOCKS:-0}"
export NT="${NT:-31}"
export NT0MIN="${NT0MIN:-}"
export DMIN="${DMIN:-350}"
export DMINX="${DMINX:-350}"
export MAX_CHANNEL_DISTANCE="${MAX_CHANNEL_DISTANCE:-400}"
export X_CENTERS="${X_CENTERS:-4}"
export NEAREST_TEMPLATES="${NEAREST_TEMPLATES:-16}"
export NEAREST_CHANS="${NEAREST_CHANS:-5}"
export MIN_TEMPLATE_SIZE="${MIN_TEMPLATE_SIZE:-50}"
export WHITENING_RANGE="${WHITENING_RANGE:-8}"
export TH_UNIVERSAL="${TH_UNIVERSAL:-9}"
export TH_LEARNED="${TH_LEARNED:-8}"
export TH_SINGLE_CH="${TH_SINGLE_CH:-6}"
