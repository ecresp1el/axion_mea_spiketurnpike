#!/usr/bin/env bash
# Example NWB packaging config for one exported Axion well.

source "${PROJECT_CONFIG:-/home/elcrespo/Desktop/githubprojects/axion_mea_spiketurnpike/config/greatlakes_project.env}"

export RECORDING_STEM="${RECORDING_STEM:-test_2_25_2026_129-8447_test(000)}"
export WELL="${WELL:-A1}"

export EXPORT_OUTPUT_DIR="${EXPORT_OUTPUT_DIR:-${KILOSORT_BINARY_ROOT}/${RECORDING_STEM}/${WELL}}"
export BINARY_FILE="${BINARY_FILE:-${EXPORT_OUTPUT_DIR}/${WELL}.bin}"
export CHANNEL_MAPPING_CSV="${CHANNEL_MAPPING_CSV:-${EXPORT_OUTPUT_DIR}/channel_mapping.csv}"
export BINARY_EXPORT_MANIFEST="${BINARY_EXPORT_MANIFEST:-${EXPORT_OUTPUT_DIR}/binary_export_manifest.json}"

export KILOSORT_OUTPUT_DIR="${KILOSORT_OUTPUT_DIR:-${KILOSORT_RESULTS_ROOT}/${RECORDING_STEM}/${WELL}}"
export KILOSORT_MANIFEST="${KILOSORT_MANIFEST:-${KILOSORT_OUTPUT_DIR}/kilosort_ready_manifest.json}"
export PROBE_JSON="${PROBE_JSON:-${KILOSORT_OUTPUT_DIR}/probe.json}"
export RAW_METADATA_INVENTORY="${RAW_METADATA_INVENTORY:-${PROJECT_ROOT}/metadata/matlab_axisfile_raw_metadata_inventory.csv}"

export NWB_OUTPUT_DIR="${NWB_OUTPUT_DIR:-${PROJECT_ROOT}/data/interim/nwb/${RECORDING_STEM}/${WELL}}"
export OUTPUT_NWB="${OUTPUT_NWB:-${NWB_OUTPUT_DIR}/${RECORDING_STEM}_${WELL}.nwb}"
export SESSION_DESCRIPTION="${SESSION_DESCRIPTION:-Axion MEA per-well continuous voltage export for Kempner/AIND ingestion}"
export TIMEZONE="${TIMEZONE:-America/Detroit}"
