// Reuse the established execution environment with single-MEA canary limits.
includeConfig 'aind_nextflow_slurm_greatlakes.config'

process {
    withName: job_dispatch { time = '10m' }
    withName: preprocessing { time = '10m' }
    withName: nwb_ecephys { time = '10m' }
    withName: postprocessing { time = '10m' }
    withName: curation { time = '10m' }
    withName: visualization { time = '10m' }
    withName: quality_control { time = '10m' }
    withName: nwb_units { time = '10m' }
    withName: results_collector { time = '10m' }
    withName: quality_control_collector { time = '10m' }
    withName: spikesort_kilosort4 { time = '30m' }
}
