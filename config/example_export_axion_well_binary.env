#!/usr/bin/env bash
# Example one-well voltage export for the first Axion-to-Kilosort test.

source "${PROJECT_CONFIG:-/home/elcrespo/Desktop/githubprojects/axion_mea_spiketurnpike/config/greatlakes_project.env}"

export AXION_LOADER_ROOT="${AXION_LOADER_ROOT:-/nfs/turbo/umms-parent/MannyAxionMEAscripts_v1/AxionFileLoader-main}"
export RECORDING_STEM="${RECORDING_STEM:-opto_test_meis2_with_E2opsin(000)}"
export WELL="${WELL:-A1}"
export DATASET="${DATASET:-BroadbandHighFrequency}"

# This recording has optogenetic stimulation in the filename and A1 spikes in
# the Axion spike-list export. Use the BroadbandProcessor file first because it
# contains the 200 Hz to 5 kHz branch intended for spike-band analyses.
export RAW_FILE="${RAW_FILE:-/nfs/turbo/umms-parent/axion_mea_files_directory/2_12_2026/129-8447/opto_test_meis2_with_E2opsin(000)_BroadbandProcessor.raw}"

# Start with a short window to validate channel order, file shape, and Kilosort
# readiness quickly. Set EXPORT_DURATION_S=600 after the short export validates.
export EXPORT_START_TIME_S="${EXPORT_START_TIME_S:-0}"
export EXPORT_DURATION_S="${EXPORT_DURATION_S:-120}"

export ELECTRODE_GEOMETRY="${ELECTRODE_GEOMETRY:-${ELECTRODE_GEOMETRY_4X4}}"
export EXPORT_OUTPUT_DIR="${EXPORT_OUTPUT_DIR:-${KILOSORT_BINARY_ROOT}/${RECORDING_STEM}/${WELL}}"
export BINARY_FILE="${BINARY_FILE:-${EXPORT_OUTPUT_DIR}/${WELL}.bin}"
export KILOSORT_ENV_FILE="${KILOSORT_ENV_FILE:-${KILOSORT_JOBS_ROOT}/${RECORDING_STEM}_${WELL}_kilosort.env}"
