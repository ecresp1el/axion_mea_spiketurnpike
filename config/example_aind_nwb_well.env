#!/usr/bin/env bash
# Run one exported Axion well NWB through the current AIND multi-backend pipeline.

source "${PROJECT_CONFIG:-/home/elcrespo/Desktop/githubprojects/axion_mea_spiketurnpike/config/greatlakes_project.env}"

export RECORDING_STEM="${RECORDING_STEM:-test_2_25_2026_129-8447_test(000)_full_lumos_settings}"
export WELL="${WELL:-A1}"
export NWB_FILE="${NWB_FILE:-${PROJECT_ROOT}/data/interim/nwb/${RECORDING_STEM}/${WELL}/${RECORDING_STEM}_${WELL}.nwb}"

export AIND_RUNMODE="${AIND_RUNMODE:-fast}"
export AIND_SORTER="${AIND_SORTER:-kilosort4}"
export AIND_PARAMS_FILE="${AIND_PARAMS_FILE:-${REPO_ROOT}/config/aind_axion_lumos_params.json}"
export AIND_ALLOW_OVERWRITE="${AIND_ALLOW_OVERWRITE:-false}"
export AIND_RESUME="${AIND_RESUME:-true}"
