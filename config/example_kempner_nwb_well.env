#!/usr/bin/env bash
# Run one Axion well NWB through the external Kempner/AIND Nextflow workflow.

export RECORDING_STEM="test_2_25_2026_129-8447_test(000)_full_lumos_settings"
export WELL="A1"
export NWB_FILE="/nfs/turbo/umms-parent/axion_mea_spiketurnpike_projectfolder/data/interim/nwb/test_2_25_2026_129-8447_test(000)_full_lumos_settings/A1/test_2_25_2026_129-8447_test(000)_full_lumos_settings_A1.nwb"

export KEMPNER_RUNMODE="fast"
export KEMPNER_SORTER="kilosort4"
export KEMPNER_N_JOBS="4"
export KEMPNER_JOB_DISPATCH_ARGS="--input nwb"
export KEMPNER_PREPROCESSING_ARGS=""
export KEMPNER_SPIKESORTING_ARGS="--params-file ${REPO_ROOT}/config/kempner_kilosort4_axion_lumos_params.json --min-drift-channels 17"
export KEMPNER_POSTPROCESSING_ARGS=""
export KEMPNER_UNIT_CLASSIFIER_ARGS=""
export KEMPNER_NWB_SUBJECT_ARGS=""
export KEMPNER_NWB_ECEPHYS_ARGS=""

export KEMPNER_ALLOW_OVERWRITE="${KEMPNER_ALLOW_OVERWRITE:-false}"
