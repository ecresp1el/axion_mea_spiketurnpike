// Great Lakes overrides for the maintained AIND DSL2 multi-backend pipeline.
// Use with:
//   -C /path/to/aind-ephys-pipeline/pipeline/nextflow_slurm.config,/path/to/this/file

params.default_queue = System.getenv('AIND_CPU_PARTITION') ?: 'standard'
params.gpu_queue = System.getenv('AIND_GPU_PARTITION') ?: 'gpu'

process {
    queue = params.default_queue
    clusterOptions = "-A ${System.getenv('AIND_ACCOUNT') ?: 'parent0'}"

    withName: spikesort_kilosort4 {
        queue = params.gpu_queue
        clusterOptions = "-A ${System.getenv('AIND_ACCOUNT') ?: 'parent0'} --gres=${System.getenv('AIND_GPU_GRES') ?: 'gpu:1'}"
    }

    withName: spikesort_kilosort25 {
        queue = params.gpu_queue
        clusterOptions = "-A ${System.getenv('AIND_ACCOUNT') ?: 'parent0'} --gres=${System.getenv('AIND_GPU_GRES') ?: 'gpu:1'}"
    }
}

singularity {
    cacheDir = System.getenv('AIND_CONTAINER_DIR')
    pullTimeout = '2h'
}

apptainer {
    cacheDir = System.getenv('AIND_CONTAINER_DIR')
    pullTimeout = '2h'
}
