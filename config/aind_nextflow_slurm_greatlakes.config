// Great Lakes overrides for the maintained AIND DSL2 multi-backend pipeline.
// Use with:
//   -C /path/to/aind-ephys-pipeline/pipeline/nextflow_slurm.config,/path/to/this/file

params.default_queue = System.getenv('AIND_CPU_PARTITION') ?: 'standard'
params.gpu_queue = System.getenv('AIND_GPU_PARTITION') ?: 'gpu'

def aind_python_shim = System.getenv('AIND_PYTHON_SHIM_DIR') ?: ''
def aind_container_home = System.getenv('AIND_CONTAINER_HOME') ?: ''
def aind_xdg_cache_home = System.getenv('AIND_XDG_CACHE_HOME') ?: ''
def host_path = System.getenv('PATH') ?: ''
def container_path = "${aind_python_shim}:/opt/conda/bin:/home/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
def python_bind = "${aind_python_shim}/python:/usr/local/bin/python"
def container_env = "--env 'PATH=${container_path}' --env 'HOME=${aind_container_home}' --env 'XDG_CACHE_HOME=${aind_xdg_cache_home}' --env 'MPLCONFIGDIR=${aind_xdg_cache_home}/matplotlib'"

env.PATH = "${aind_python_shim}:${host_path}:/opt/conda/bin:/home/miniconda3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
env.HOME = aind_container_home
env.XDG_CACHE_HOME = aind_xdg_cache_home
env.MPLCONFIGDIR = "${aind_xdg_cache_home}/matplotlib"

process {
    queue = params.default_queue
    clusterOptions = "-A ${System.getenv('AIND_ACCOUNT') ?: 'parent0'}"

    // Axion MEA wells are short once scheduled; overly long default walltimes
    // prevent Slurm backfill and caused the 2026-07-09 Lumos backlog.
    withName: job_dispatch {
        time = '2m'
    }

    withName: preprocessing {
        time = '2m'
    }

    withName: nwb_ecephys {
        time = '2m'
    }

    withName: postprocessing {
        time = '2m'
    }

    withName: curation {
        time = '2m'
    }

    withName: visualization {
        time = '2m'
    }

    withName: quality_control {
        time = '2m'
    }

    withName: nwb_units {
        time = '2m'
    }

    withName: results_collector {
        time = '2m'
    }

    withName: quality_control_collector {
        time = '2m'
    }

    withName: spikesort_kilosort4 {
        queue = params.gpu_queue
        time = '5m'
        clusterOptions = "-A ${System.getenv('AIND_ACCOUNT') ?: 'parent0'} --gres=${System.getenv('AIND_GPU_GRES') ?: 'gpu:1'}"
    }

    withName: spikesort_kilosort25 {
        queue = params.gpu_queue
        time = '5m'
        clusterOptions = "-A ${System.getenv('AIND_ACCOUNT') ?: 'parent0'} --gres=${System.getenv('AIND_GPU_GRES') ?: 'gpu:1'}"
    }
}

singularity {
    cacheDir = System.getenv('AIND_CONTAINER_DIR')
    pullTimeout = '2h'
    runOptions = "-B '${python_bind}' ${container_env}"
}

apptainer {
    cacheDir = System.getenv('AIND_CONTAINER_DIR')
    pullTimeout = '2h'
    runOptions = "-B '${python_bind}' ${container_env}"
}
